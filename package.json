{
    "name": "tlogviewer",
    "version": "1.0.0",
    "type": "module",
    "description": "A js viewer for mavlink telemetry logs",
    "author": "Willian Galvani <williangalvani@gmail.com>",
    "private": true,
    "scripts": {
        "dev": "cross-env NODE_ENV=development node --max_old_space_size=4096 node_modules/webpack-dev-server/bin/webpack-dev-server.js --host 0.0.0.0 --progress --config build/webpack.dev.conf.js",
        "start": "serve -s dist -l 8080 -c ../serve.json",
        "start:dev": "npm run dev",
        "unit": "vitest run --coverage",
        "e2e": "npm run build && node test/e2e/runner.js",
        "test": "npm run unit && npm run e2e",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "lint:css": "stylelint \"src/**/*.{vue,css,scss}\"",
        "lint:md": "markdownlint-cli2",
        "lint:all": "npm run lint && npm run lint:css && npm run lint:md && npm run format:check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build": "cross-env NODE_ENV=production node --max_old_space_size=4096 node_modules/webpack/bin/webpack.js --config build/webpack.prod.conf.js"
    },
    "dependencies": {
        "serve": "^14.2.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@photostructure/tz-lookup": "^11.7.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.4",
        "autoprefixer": "^9.8.8",
        "bootstrap": "^5.3.8",
        "buffer": "^6.0.3",
        "cesium": "^1.146.0",
        "colormap": "^2.3.2",
        "compression-webpack-plugin": "^10.0.0",
        "copy-webpack-plugin": "^11.0.0",
        "cross-env": "~5.2",
        "cross-spawn": "^5.1.0",
        "css-loader": "^6.7.2",
        "css-minimizer-webpack-plugin": "^4.2.2",
        "culori": "^4.0.2",
        "dji-log-parser-js": "^0.5.7",
        "epic-spinners": "^2.0.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-vue": "^10.11.1",
        "eslint-webpack-plugin": "^6.0.0",
        "events": "^3.3.0",
        "fast-xml-parser": "^5.11.2",
        "git-revision-webpack-plugin": "^3.0.6",
        "glob": "^7.2.3",
        "globals": "^17.13.0",
        "html-webpack-plugin": "^5.5.0",
        "is-online": "^12.0.2",
        "jsdom": "^30.1.2",
        "jspack": "0.0.4",
        "luxon": "^3.7.2",
        "markdownlint-cli2": "^0.23.3",
        "mini-css-extract-plugin": "^2.7.1",
        "neostandard": "^0.14.0",
        "nightwatch": "^3.16.0",
        "plotly.js": "^4.1.2",
        "portfinder": "^1.0.28",
        "postcss-html": "^2.0.0",
        "postcss-import": "^15.1.0",
        "postcss-loader": "^7.0.2",
        "postcss-url": "^10.1.3",
        "prettier": "^3.9.9",
        "stylelint": "^17.16.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.4",
        "vue": "^3.5.44",
        "vue-eslint-parser": "^10.4.1",
        "vue-loader": "^17.4.2",
        "vue-router": "^5.4.0",
        "vue-style-loader": "~4.1",
        "webpack": "^5.75.0",
        "webpack-bundle-analyzer": "^4.5.0",
        "webpack-cli": "^5.0.0",
        "webpack-dev-server": "^4.9.3",
        "webpack-merge": "^5.8.0"
    },
    "engines": {
        "node": ">=22",
        "npm": ">=9"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "overrides": {
        "selenium-webdriver": "^4.51.0"
    }
}
