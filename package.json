{
    "name": "tlogviewer",
    "version": "1.0.0",
    "type": "module",
    "description": "A js viewer for mavlink telemetry logs",
    "author": "Willian Galvani <williangalvani@gmail.com>",
    "private": true,
    "scripts": {
        "dev": "vite",
        "start": "serve -s dist -l 8080 -c ../serve.json",
        "start:dev": "npm run dev",
        "unit": "vitest run --coverage",
        "e2e": "npm run build && node test/e2e/runner.js",
        "test": "npm run unit && npm run e2e",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "lint:css": "stylelint \"src/**/*.{vue,css,scss}\"",
        "lint:md": "markdownlint-cli2",
        "lint:all": "npm run lint && npm run lint:css && npm run lint:md && npm run format:check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build": "vite build"
    },
    "dependencies": {
        "serve": "^14.2.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@photostructure/tz-lookup": "^11.7.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.4",
        "autoprefixer": "^10.6.1",
        "bootstrap": "^5.3.8",
        "buffer": "^6.0.3",
        "cesium": "^1.146.0",
        "colormap": "^2.3.2",
        "cross-spawn": "^7.0.6",
        "culori": "^4.0.2",
        "dji-log-parser-js": "^0.5.7",
        "epic-spinners": "^2.0.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-no-relative-import-paths": "^1.7.3",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-vue": "^10.11.1",
        "events": "^3.3.0",
        "fast-xml-parser": "^5.11.2",
        "glob": "^10.4.5",
        "globals": "^17.13.0",
        "is-online": "^12.0.2",
        "jsdom": "^30.1.2",
        "jsep": "^1.6.0",
        "jspack": "0.0.4",
        "luxon": "^3.7.2",
        "markdownlint-cli2": "^0.23.3",
        "neostandard": "^0.14.0",
        "nightwatch": "^3.16.0",
        "plotly.js": "^4.1.2",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.9",
        "stylelint": "^17.16.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "vite": "^8.3.4",
        "vite-plugin-eslint2": "^5.3.0",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.4",
        "vue": "^3.5.44",
        "vue-eslint-parser": "^10.4.1",
        "vue-router": "^5.4.0"
    },
    "engines": {
        "node": ">=22.12",
        "npm": ">=9"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "overrides": {
        "selenium-webdriver": "^4.51.0",
        "brace-expansion@1": ">=1.1.21",
        "compression": ">=1.8.2",
        "fast-uri": ">=3.1.8",
        "katex": ">=0.18.2",
        "lodash": ">=4.17.23",
        "picomatch@2": ">=2.3.2",
        "serialize-javascript": ">=7.0.5",
        "smol-toml": ">=1.8.1",
        "uuid": ">=11.1.1"
    }
}
