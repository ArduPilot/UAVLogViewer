// https://github.com/DavidAnson/markdownlint-cli2
{
    "globs": ["**/*.md"],
    "ignores": [
        "node_modules/**",
        "dist/**",
        "src/tools/parsers/JsDataflashParser/**",
        "test/e2e/reports/**",
        // Python virtual environments (scripts/terrain/.venv)
        "**/.venv/**",
    ],
    "config": {
        // prettier owns line wrapping
        "MD013": false,
    },
}
