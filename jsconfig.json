{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "checkJs": false
    },
    "include": ["src/**/*", "test/**/*", "build/**/*", "config/**/*"],
    "exclude": ["node_modules", "dist"]
}
