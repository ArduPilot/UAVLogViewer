{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "checkJs": false
    },
    "include": ["src/**/*", "test/**/*", "*.js"],
    "exclude": ["node_modules", "dist"]
}
